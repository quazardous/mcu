HELP_CONFIG = """mcuctl reads its settings from the environment, else from the file
MCU_CONFIG names (default: client/.env.local next to mcuctl), KEY=value lines:

  MCU_HOST=mcu-<project>@<box>   your project's user on the box (BENCH_HOST, for one release)
