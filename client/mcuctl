#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""mcuctl: drive an mcu box from your machine, as a project or as its admin.

The key and the host are configuration (`mcuctl help config`), so a command
line is only `mcuctl <command> ...`: no ssh, no host, no sudo in sight.
"""

import json
import shlex
import subprocess
import sys
import tarfile
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from mcu.core import EX_TEMPFAIL, PROJECT_VERBS, Box, ConfigError, load_config  # noqa: E402

REPO = Path(__file__).resolve().parent.parent
LIB = "/usr/local/lib/mcu"

