#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# the mcu box's admin commands (mcu: multiple compute unit); run as root (the admin's sudo). Projects
# then run themselves: they configure their repo, disk and volumes through
# their own SSH key (mcu-job config / volume), inside the box's envelope.
#
#   mcu-admin init [--config]    install or update the box from this checkout
#                                  (--config: replace /etc/mcu/box.toml by box.local.toml)
#                                  (box.local.toml holds this machine's settings)
#   mcu-admin config show          each setting in force and where it comes from
#   mcu-admin doctor               what this machine has and lacks for mcu (read-only)
#   mcu-admin uninstall [--purge [--yes]]
#                                  services, code and system files off; the data stays,
#                                  unless --purge (refused while jobs run)
#   mcu-admin invite <project>   create the project if needed and print a new
#                                  private key for it, its API key; replaces any
#                                  previous key
#   mcu-admin revoke <project>   remove the project's key; its data stays
#   mcu-admin reclaim <project> [reason]
#                                  free what the project can regenerate: images,
#                                  build leftovers, storage tagged tmp, results
#                                  older than 2 days
#   mcu-admin purge <project> [--volumes] [reason]
#                                  free everything but its identity (key, settings,
#                                  Benchfiles): images, caches, src, all results;
#                                  its volumes too with --volumes
#                                  Both refuse while the project has jobs queued or
#                                  running, and the project's agent is told
#   mcu-admin prune              remove job results past their retention now
#   mcu-admin passwd [--generate]  set the dashboard's admin password (stdin), or
#                                  generate one and print it once
#   mcu-admin queue open [--if-by <who>] | pause|close <reason> [--until <time>] [--by <who>]
#                                  the queue's mode: paused accepts jobs but starts
#                                  none; closed refuses new jobs (exit 75, with the
#                                  reason) and starts none; running ones finish
#   mcu-admin maintenance on <reason> | off
#                                  the same as queue close | queue open
#   mcu-admin migrate <project> [<unit>] <pool>
#                                  move one unit (or all) of a project to a pool
#   mcu-admin pool list | budget <mount|pool> <size> | add <name> <path> | default <name> | retire <name>
#                                  the box's storage pools (mounted, prjquota)
#   mcu-admin gpu eject | attach
#                                  take the eGPU off the bus to unplug it (GPU jobs
#                                  refused, running ones waited for), or bring it back
#   mcu-admin task add <kind> [args...] | list | show <id> | cancel <id>
#                                  long operations, run by mcu-task.service
#   mcu-admin envelope [list] | set <key> <value> | reset <key>
#                                  the limits any project may ask for (overrides box.toml)
#   mcu-admin power fast|balanced|quiet
#                                  the CPU's power profile (RAPL long-term limit)
#   mcu-admin quota <project> [ssd|hdd] <size>|none
#                                  the admin's own quota for a project, up to twice
#                                  the envelope's max_disk_ssd (max_disk_hdd); sticks over its setting
#   mcu-admin timing [cooldown on|off] [target auto|<C>] [cap <pct>|none] [max <s>]
#                                  the profile of timing jobs (timing = true)
#   mcu-admin list               the projects and their settings
#   mcu-admin shutdown reboot|poweroff | cancel | status
#                                  a graceful restart or power-off: queue closed,
#                                  eGPU ejected, running jobs waited for, a 60 s
#                                  countdown; cancellable until it ends
#   mcu-admin status             the box at a glance, as JSON: queue, running and
#                                  waiting jobs (memory reserved and used), GPU,
#                                  machine, power profile, envelope
#   mcu-admin orphans [--stop]   job containers still running after their job
#                                  ended (a runner killed before it stopped them)
#   mcu-admin cancel <project> <id>|--branch <branch>
#                                  cancel a project's job, as the project would
#
# The dashboard (as mcu-web) may run, through sudo, only the subcommands its
# sudoers rule lists (see init): invite, revoke, prune, maintenance, queue,
# reclaim, purge, timing, quota, pool, migrate, envelope, task, power, shutdown,
# cancel.

set -euo pipefail

# the real directory, also when called through /usr/local/bin/mcu-admin (a
# link): its Python modules (mcuconf, hw) sit next to it
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
lib=/usr/local/lib/mcu
state=/var/lib/mcu

die() { echo "mcu-admin: $*" >&2; exit 2; }
[ "$(id -u)" = 0 ] || die "run as root"

toml_get() {  # toml_get <file> <python expression on the parsed dict>
  python3 -c "import sys, tomllib; d = tomllib.load(open(sys.argv[1], 'rb')); print($2)" "$1"
}
envelope_get() {  # envelope_get <key> [<unused>]: the envelope value in force (mcuconf)
  python3 "$here/mcuconf.py" get "envelope.$1"
}
# pool_path [<project>]: the path of the project's pool (its settings), or of
# the default pool; empty without pools (everything in the homes)
pool_path() {
  python3 - "${1:-}" <<'PY'
import json, sys, tomllib
from pathlib import Path
st = Path("/var/lib/mcu")
try:
    data = json.load(open(st / "pools.json"))
except (OSError, ValueError):
    data = {}
if not data.get("pools"):
    d = tomllib.load(open("/etc/mcu/box.toml", "rb")).get("projects_dir")
    data = {"pools": {"data": {"path": d}}, "default": "data"} if d else {"pools": {}}
name = data.get("default")
if sys.argv[1]:
    try:
        name = json.load(open(st / "projects" / f"{sys.argv[1]}.json")).get("pool") or name
    except (OSError, ValueError):
        pass
print(data["pools"].get(name, {}).get("path", "") if name else "")
PY
}
projects_dir() { pool_path "${1:-}"; }
# make_tree <project>: the project's tree on the data filesystem, under an
# XFS project quota (its uid) set to its disk; podman stores its images there
make_tree() {
  local p="$1" user="mcu-$1" pd uid home t
  pd="$(projects_dir "$p")"; [ -n "$pd" ] || return 0
  uid="$(id -u "$user")"; home="$(getent passwd "$user" | cut -d: -f6)"; t="$pd/$p"
  install -d -o "$user" -g "$user" -m 700 "$t" "$t/containers" "$t/cache" "$t/jobs" "$t/tmp"
  # xfs_quota wants the filesystem's mount point, a pool may be a directory on it
  # on a pool with project quotas, the tree gets the project's id; on the
  # system's filesystem the user quota polices it instead
  mnt="$(df --output=target "$pd" | tail -1)"
  if xfs_quota -x -c "state -p" "$mnt" 2>/dev/null | grep -q "Enforcement: ON"; then
    xfs_quota -x -c "project -s -p $t $uid" "$mnt" > /dev/null
  fi
  chcon -R -t container_file_t "$t"
  # both levels the project's: install -d would make a missing ~/.config root's,
  # and podman then refuses every build
  install -d -o "$user" -g "$user" -m 700 "$home/.config" "$home/.config/containers"
  printf '[storage]\ndriver = "overlay"\ngraphroot = "%s"\n' "$t/containers" > "$home/.config/containers/storage.conf"
  chown "$user:$user" "$home/.config/containers/storage.conf"
  disk="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('disk') or '')" "$state/projects/$p.json")"
  [ -n "$disk" ] || disk="$(envelope_get default_disk 10g)"
  SUDO_USER="$user" "$lib/mcu-helper" quota "$disk" > /dev/null
}
# pick_pool <project>: record the pool a new project goes to: the default
# pool when it has room for its quota, else the pool with the most room left
# after the quotas already promised there
pick_pool() {
  python3 - "$1" <<'PY'
import json, os, sys
from pathlib import Path
st = Path("/var/lib/mcu")
p = sys.argv[1]
try:
    data = json.load(open(st / "pools.json"))
except (OSError, ValueError):
    data = {}
pools = data.get("pools") or {}
if not pools:
    sys.exit(0)
try:
    usage = json.load(open(st / "usage.json"))
except (OSError, ValueError):
    usage = {}
def room(name):
    # the pool's budget (0: disabled) minus the quotas promised there, and
    # never more than the filesystem's free space
    try:
        v = os.statvfs(pools[name]["path"])
    except OSError:
        return -1
    free = v.f_bavail * v.f_frsize
    budget = pools[name].get("budget", v.f_blocks * v.f_frsize)
    if not budget:
        return -1
    promised = sum(u.get("quota", 0) for k, u in usage.items() if not k.startswith("_") and u.get("pool") == name)
    return min(budget - promised, free)
default = data.get("default")
open_pools = [n for n in pools if room(n) > 0]
if not open_pools:
    sys.exit("mcu-admin: no pool has budget left for a new project (admin, Disk tab)")
pick = default if default in open_pools and room(default) > 20 * 2**30 else max(open_pools, key=room)
path = st / "projects" / f"{p}.json"
conf = json.load(open(path))
conf["pool"] = pick
json.dump(conf, open(path, "w"), indent=1)
PY
}
# convert_units <project>: a project tree from before units (the home's
# cache one symlink to <pool>/<p>/cache) becomes one link per storage, so
# each can move on its own
convert_units() {
  local p="$1" home user t e
  user="mcu-$p"; home="$(getent passwd "$user" | cut -d: -f6)"
  [ -L "$home/cache" ] || return 0
  t="$(readlink "$home/cache")"
  rm "$home/cache"
  install -d -o "$user" -g "$user" -m 700 "$home/cache"
  for e in "$t"/* "$t"/.git; do
    [ -e "$e" ] || continue
    ln -s "$e" "$home/cache/$(basename "$e")"
    chown -h "$user:$user" "$home/cache/$(basename "$e")"
  done
  chcon -t container_file_t "$home/cache"
}
# hw_present <module>: the optional hardware is on this machine (box/hw)
hw_present() {
  python3 -c "import sys; sys.path.insert(0, sys.argv[1]); import importlib; m = importlib.import_module('hw.' + sys.argv[2]); sys.exit(m.detect()[0] == 'absent')" "$here" "$1"
}
check_name() { [[ "$1" =~ ^[a-z][a-z0-9-]{1,20}$ ]] && [ "$1" != web ] || die "bad project name"; }

case "${1:-}" in
  init)
    # the machine's settings: box.local.toml the first time; afterwards
    # /etc/mcu/box.toml is the machine's own (a checkout without one updates)
    [ -f "$here/box.local.toml" ] || [ -f /etc/mcu/box.toml ] || die "no $here/box.local.toml (copy box.example.toml)"
    groupadd -f mcu
    install -d -m 2770 -g mcu "$state"
    for f in sched.lock state.json events.jsonl; do
      touch "$state/$f"
      chgrp mcu "$state/$f" && chmod 660 "$state/$f"
    done
    install -d -m 755 "$state/projects" "$state/volumes" "$lib" /etc/mcu
    install -d -m 755 "$state/keys"   # public key fingerprints, for the dashboard
    # /etc/mcu/box.toml is the machine's own file once it exists (the admin,
    # `envelope set` and the dashboard edit it): installed from box.local.toml
    # the first time, or on `init --config`; otherwise only compared
    if [ ! -f /etc/mcu/box.toml ] || [ "${2:-}" = --config ]; then
      [ -f /etc/mcu/box.toml ] && cp -p /etc/mcu/box.toml "/etc/mcu/box.toml.bak.$(date +%Y%m%d-%H%M%S)"
      install -m 644 "$here/box.local.toml" /etc/mcu/box.toml
    elif [ -f "$here/box.local.toml" ] && ! cmp -s "$here/box.local.toml" /etc/mcu/box.toml; then
      echo "mcu-admin: /etc/mcu/box.toml differs from $here/box.local.toml and is kept (init --config replaces it):" >&2
      diff -u /etc/mcu/box.toml "$here/box.local.toml" | head -40 >&2 || true
    fi
    # an older box's queue flags (maintenance.json: closed, hold.json: paused
    # or closed) become queue.json
    python3 - "$state" <<'PY'
import json, os, sys
st = sys.argv[1]
def read(name):
    try:
        return json.load(open(os.path.join(st, name)))
    except (OSError, ValueError):
        return None
m, h = read("maintenance.json"), read("hold.json")
if (m or h) and not os.path.exists(os.path.join(st, "queue.json")):
    src = m or h
    by = f"deploy:{src['pid']}" if src.get("by") == "deploy" and src.get("pid") else "root"
    q = {"mode": "closed" if m else "paused", "reason": src.get("reason") or "set before an upgrade",
         "since": src.get("since"), "until": src.get("until"), "by": by}
    with open(os.path.join(st, "queue.json"), "w") as f:
        json.dump(q, f)
    os.chmod(os.path.join(st, "queue.json"), 0o644)
    print(f"mcu-admin: queue flags turned into queue.json ({q['mode']})")
for name in ("maintenance.json", "hold.json"):
    if os.path.exists(os.path.join(st, name)):
        os.unlink(os.path.join(st, name))
PY
    # an older box's dashboard values (envelope.json) move into box.toml
    [ -e "$state/envelope.json" ] && "$0" envelope fold-legacy
    # which Benchfile sets each project's quota (the dashboard shows it, and
    # cannot read Benchfiles): noted at each upload, filled here for projects
    # whose Benchfiles came before that (once; HOME: where mcu.py finds them)
    for f in "$state"/projects/*.json; do
      [ -f "$f" ] || continue
      p="$(basename "$f" .json)"
      [ -d "/home/mcu-$p" ] || continue
      grep -q '"disk_by_benchfile"' "$f" && continue
      HOME="/home/mcu-$p" python3 - "$here" "$f" <<'PY' || echo "mcu-admin: $p: quota source not noted" >&2
import json, sys
sys.path.insert(0, sys.argv[1])
import mcu
conf = json.load(open(sys.argv[2]))
mcu.note_disk_source(conf)
with open(sys.argv[2], "r+") as fh:   # in place: the file keeps its owner
    fh.write(json.dumps(conf, indent=1) + "\n")
    fh.truncate()
PY
    done
    # rootless podman can only pin a job to cores (--cpuset-cpus) when
    # systemd delegates the cpuset controller to user sessions
    install -d /etc/systemd/system/user@.service.d
    printf '[Service]\nDelegate=cpu cpuset io memory pids\n' \
      > /etc/systemd/system/user@.service.d/mcu-delegate.conf
    # the files, from box/install.list (the same list as make install and
    # mcuctl admin deploy); the dashboard comes built (npm run build, or a
    # release): the box serves the files and runs no node
    # (run from the installed copy, after make install, the files are there)
    if [ -x "$here/install-files" ]; then
      "$here/install-files" || die "the files could not be installed"
    fi
    rm -f "$lib/dashboard.py"
    # what may run as root: projects only the helper (their quota and
    # volumes); the dashboard only the subcommands listed below
    cat > /etc/sudoers.d/mcu <<EOF
%mcu,!mcu-web ALL=(root) NOPASSWD: $lib/mcu-helper
mcu-web ALL=(root) NOPASSWD: $lib/mcu-admin invite *, $lib/mcu-admin revoke *, $lib/mcu-admin prune, $lib/mcu-admin maintenance *, $lib/mcu-admin queue *, $lib/mcu-admin reclaim *, $lib/mcu-admin purge *, $lib/mcu-admin timing *, $lib/mcu-admin quota *, $lib/mcu-admin pool *, $lib/mcu-admin migrate *, $lib/mcu-admin envelope *, $lib/mcu-admin task *, $lib/mcu-admin power *, $lib/mcu-admin shutdown *, $lib/mcu-admin cancel *
EOF
    chmod 440 /etc/sudoers.d/mcu
    visudo -cqf /etc/sudoers.d/mcu || die "sudoers rule rejected"
    install -d -m 755 /srv/mcu/volumes
    if command -v nvidia-ctk > /dev/null; then
      # jobs holding the gpu resource get the NVIDIA GPU through CDI; SELinux
      # lets containers use the devices passed to them
      nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml > /dev/null 2>&1
      # the toolkit's own refresh fires many times while the driver loads at
      # boot and hit its start limit (a failed unit at every boot)
      install -d /etc/systemd/system/nvidia-cdi-refresh.path.d
      printf '[Unit]\nStartLimitIntervalSec=0\n' > /etc/systemd/system/nvidia-cdi-refresh.path.d/mcu-start-limit.conf
      setsebool -P container_use_devices 1
    fi
    semanage fcontext -a -t container_file_t '/srv/mcu/volumes(/.*)?' 2> /dev/null \
      || semanage fcontext -m -t container_file_t '/srv/mcu/volumes(/.*)?'
    restorecon -R /srv/mcu/volumes
    # projects and volumes of the previous, admin-configured format
    for f in /etc/mcu/projects/*.toml; do
      [ -f "$f" ] || continue
      p="$(basename "$f" .toml)"
      [ -f "$state/projects/$p.json" ] || python3 - "$f" "$state/projects/$p.json" <<'PY'
import json, sys, tomllib
d = tomllib.load(open(sys.argv[1], "rb"))
json.dump({"repo": d.get("repo", ""), "manifest": d.get("manifest", "tools/bench/bench.toml")},
          open(sys.argv[2], "w"), indent=1)
PY
      chown "mcu-$p:mcu" "$state/projects/$p.json" 2> /dev/null || true
      rm -f "$f"
    done
    for f in /etc/mcu/volumes/*.toml; do
      [ -f "$f" ] || continue
      v="$(basename "$f" .toml)"
      [ -f "$state/volumes/$v.json" ] || python3 - "$f" "$state/volumes/$v.json" <<'PY'
import json, sys, tomllib
d = tomllib.load(open(sys.argv[1], "rb"))
json.dump({"owner": d["owner"], "readers": d.get("readers", []),
           "keep_versions": d.get("keep_versions", 2)}, open(sys.argv[2], "w"), indent=1)
PY
      rm -f "$f"
    done
    rmdir /etc/mcu/projects /etc/mcu/volumes 2> /dev/null || true
    # project trees from before units: one link per storage
    for f in "$state"/projects/*.json; do
      [ -f "$f" ] && getent passwd "mcu-$(basename "$f" .json)" > /dev/null && convert_units "$(basename "$f" .json)"
    done
    # a ~/.config an older invite left to root: the project's again
    for f in "$state"/projects/*.json; do
      [ -f "$f" ] || continue
      p="$(basename "$f" .json)"
      h="$(getent passwd "mcu-$p" | cut -d: -f6)" || continue
      if [ -d "$h/.config" ] && [ ! -L "$h/.config" ] && [ "$(stat -c %u "$h/.config")" = 0 ]; then
        chown "mcu-$p:mcu-$p" "$h/.config" && chmod 700 "$h/.config"
        echo "mcu-admin: $h/.config given back to mcu-$p"
      fi
    done
    # fingerprints of keys installed before invite existed, for the dashboard
    for f in "$state"/projects/*.json; do
      [ -f "$f" ] || continue
      p="$(basename "$f" .json)"
      ak="$(getent passwd "mcu-$p" | cut -d: -f6)/.ssh/authorized_keys"
      [ -s "$ak" ] && [ ! -f "$state/keys/$p.fingerprint" ] \
        && sed 's/^[^ ]* //' "$ak" | ssh-keygen -lf - | awk '{print $2}' | head -1 > "$state/keys/$p.fingerprint"
    done
    # the dashboard: an API and its single page app, all behind a password, TLS
    id mcu-web > /dev/null 2>&1 || useradd -r -M -s /sbin/nologin -G mcu mcu-web
    # the dashboard's sessions, kept across its restarts (token hashes only)
    install -d -o mcu-web -g mcu-web -m 700 /var/lib/mcu-web
    if [ ! -f /etc/mcu/dashboard.pem ]; then
      # ECDSA P-256: browsers do not take Ed25519 certificates (Firefox:
      # SSL_ERROR_NO_CYPHER_OVERLAP)
      openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 3650 -subj "/CN=$(hostname)" \
        -addext "subjectAltName=DNS:$(hostname)" \
        -keyout /etc/mcu/dashboard.key -out /etc/mcu/dashboard.pem 2> /dev/null
      chgrp mcu-web /etc/mcu/dashboard.key && chmod 640 /etc/mcu/dashboard.key
    fi
    port="$(python3 "$here/mcuconf.py" get dashboard_port)"
    cat > /etc/systemd/system/mcu-dashboard.service <<EOF
[Unit]
Description=mcu box dashboard
After=network-online.target

[Service]
User=mcu-web
# its own group reads the TLS key and admin.json; mcu reads the state
Group=mcu-web
SupplementaryGroups=mcu
ExecStart=/usr/bin/python3 $lib/api.py --port $port
Restart=on-failure
# no ProtectSystem/ProtectHome: the admin page's sudo mcu-admin invite
# inherits this mount view, and it creates users and their homes. The
# limits are the unprivileged user and the narrow sudoers rule.
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
EOF
    # time series: rrdtool databases written by mcu-web
    command -v rrdtool > /dev/null || dnf -y -q install rrdtool > /dev/null
    # the eGPU's rule and the NVIDIA driver options: only with an NVIDIA GPU,
    # found or declared ([resources] gpu); otherwise none of it (the block
    # below keeps its indentation: its heredocs are written as they are)
    if hw_present nvidia || python3 "$here/mcuconf.py" get resources | grep -q gpu; then
    # the eGPU: its plug and unplug handled at once, as root through
    # systemd-run so udev never waits: mcu-helper gpu-event clears an eject
    # when the driver takes the card back, marks a pull without eject, and
    # reloads the driver when the enclosure comes back after one; then the
    # collector's GPU pass tells the dashboard and the scheduler
    cat > /etc/udev/rules.d/90-mcu-egpu.rules <<EOF
# mcu: the NVIDIA eGPU's driver binds or goes, its Thunderbolt enclosure comes
# or goes (installed by mcu-admin init)
ACTION=="bind|unbind|remove", SUBSYSTEM=="pci", ENV{PCI_ID}=="10DE:*", ENV{PCI_CLASS}=="30000|30200", \\
    RUN+="/usr/bin/systemd-run --no-block --quiet --collect /usr/bin/python3 $lib/mcu-helper gpu-event \$env{ACTION}"
ACTION=="add|remove", SUBSYSTEM=="thunderbolt", ENV{DEVTYPE}=="thunderbolt_device", \\
    RUN+="/usr/bin/systemd-run --no-block --quiet --collect /usr/bin/python3 $lib/mcu-helper gpu-event thunderbolt-\$env{ACTION}"
# the host's Thunderbolt controller stays awake: on this Intel TB3 NUC, once
# runtime-suspended after an unplug it failed every resume (tb_domain_runtime_resume,
# "failed to send driver ready to ICM") and never saw the enclosure come back
ACTION=="add|bind", SUBSYSTEM=="pci", DRIVER=="thunderbolt", ATTR{power/control}="on"
EOF
    for nhi in /sys/bus/pci/drivers/thunderbolt/0000:*; do
      [ -e "$nhi/power/control" ] && echo on > "$nhi/power/control"
    done
    # at power-off, let go of the eGPU before the Thunderbolt stack is torn
    # down (after amd-usb4-egpu-toolkit's shutdown helper): a hung power-off
    # otherwise
    cat > /etc/systemd/system/mcu-egpu-shutdown.service <<EOF
[Unit]
Description=mcu: let go of the NVIDIA eGPU before power-off
DefaultDependencies=no
After=multi-user.target
Before=shutdown.target final.target
Conflicts=reboot.target poweroff.target halt.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/bin/python3 $lib/mcu-helper gpu-shutdown
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable --now mcu-egpu-shutdown.service > /dev/null 2>&1
    # a power-off or reboot that hangs (the eGPU's driver or the
    # Wi-Fi stuck in the kernel) ends in a reset by the hardware watchdog
    # after 5 min, rather than waiting for someone at the power button
    install -d /etc/systemd/system.conf.d
    cat > /etc/systemd/system.conf.d/mcu-reboot-watchdog.conf <<EOF
# mcu (mcu-admin init): the hardware watchdog resets a hung power-off or reboot
[Manager]
RebootWatchdogSec=5min
EOF
    systemctl daemon-reload
    # no console on the card (fbdev off: nothing holds it at a removal), but
    # modeset on: NVIDIA's GBM backend needs it, and every compositor of a
    # display = "gpu" job goes through GBM; applies when the driver next
    # loads (a reboot, or a reload after a pull)
    cat > /etc/modprobe.d/mcu-nvidia-headless.conf <<EOF
