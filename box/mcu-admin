    # changed is backed up, and --reverse puts it back. Each project keeps
    # a bench-<project> alias (same uid, same home) so old clients still
    # log in, until --drop-aliases. Idempotent: a step already done is
    # skipped.
    mode="${2:-}"
    [ $# -le 2 ] && { [ -z "$mode" ] || [ "$mode" = --reverse ] || [ "$mode" = --drop-aliases ]; } \
      || die "usage: migrate-name [--reverse | --drop-aliases]"
    if [ "$mode" = --drop-aliases ]; then
      for u in $(getent passwd | cut -d: -f1 | grep '^bench-' | grep -v '^bench-web$'); do
        p="${u#bench-}"
        [ "$(id -u "$u")" = "$(id -u "mcu-$p" 2> /dev/null)" ] || continue   # only an alias, never a real account
        for g in $(getent group | awk -F: -v a="$u" '("," $4 ",") ~ ("," a ",") {print $1}'); do
          gpasswd -d "$u" "$g" > /dev/null
        done
        sed -i "/^$u:/d" /etc/passwd /etc/shadow
        echo "migrate-name: alias $u removed"
      done
      exit 0
    fi
    if [ "$mode" = --reverse ]; then
      old=mcu new=bench
      "$0" migrate-name --drop-aliases   # bench-<p> becomes the real name again
    else
      old=bench new=mcu
    fi
    backup=/root/mcu-migrate-name
    [ "$mode" = --reverse ] && [ ! -d "$backup" ] && die "no backup at $backup: nothing to reverse"
    oldstate=/var/lib/$old
    [ -d "$oldstate" ] || { echo "migrate-name: no /var/lib/$old: already done"; exit 0; }
    # the queue closes and running jobs end (the old code still runs them)
    if [ -f "$oldstate/state.json" ]; then
      printf '{"reason": "renaming the box (%s -> %s)", "since": %s}\n' "$old" "$new" "$(date +%s)" > "$oldstate/maintenance.json"
      for i in $(seq 1 7200); do
        n=$(python3 -c "import json,sys; print(len(json.load(open(sys.argv[1])).get('running', [])))" "$oldstate/state.json" 2> /dev/null || echo 0)
        [ "$n" = 0 ] && break
        [ "$i" = 1 ] && echo "migrate-name: waiting for $n running job(s)"
        sleep 3
      done
      [ "$n" = 0 ] || die "jobs still running after 6 h; nothing changed"
    fi
    # one backup per migration, made by its first run (a rerun after a
    # failure must not save the half-renamed state over it); --reverse
    # files it away, so a later migration takes a fresh one
    if [ "$mode" != --reverse ] && [ ! -d "$backup" ]; then
      echo "migrate-name: backup in $backup"
      install -d -m 700 "$backup"
      cp -a /etc/passwd /etc/group /etc/shadow /etc/gshadow /etc/subuid /etc/subgid /etc/fstab "$backup/" 2> /dev/null || true
      cp -a /etc/sudoers.d/bench "$backup/" 2> /dev/null || true
      cp -a /etc/systemd/system/bench-* "$backup/" 2> /dev/null || true
      cp -a /etc/bench "$backup/etc-bench" 2> /dev/null || true
      cp -a /usr/local/lib/bench "$backup/lib-bench" 2> /dev/null || true
      semanage fcontext -l -C 2> /dev/null | grep '/srv/bench' > "$backup/fcontext" || true
    fi
    # the services stop, so nothing holds the old paths or accounts
    # (only those the rename touches: mcu-egpu-shutdown and mcu-power had
    # their name before)
    renamed_units="dashboard.service task.service recover.service prune.service prune.timer usage.service usage.timer collect.service collect.timer"
    for unit in $renamed_units; do
      systemctl disable --now "$old-$unit" > /dev/null 2>&1 || true
    done
    # the accounts: projects (bench-<p>), the dashboard's user, the groups
    for u in $(getent passwd | cut -d: -f1 | grep "^$old-"); do
      nu="$new-${u#$old-}"
      getent passwd "$nu" > /dev/null && [ "$(id -u "$nu")" != "$(id -u "$u")" ] && die "$nu exists with another uid"
      # an alias left from a previous run: the real account is already renamed
      [ "$(getent passwd | awk -F: -v uid="$(id -u "$u")" '$3 == uid' | wc -l)" -gt 1 ] && continue
      loginctl disable-linger "$u" 2> /dev/null || true
      loginctl terminate-user "$u" 2> /dev/null || true
      # usermod refuses while a process runs as the user: wait for them all
      for _ in $(seq 1 100); do
        pkill -KILL -u "$u" 2> /dev/null || break
        sleep 0.2
      done
      pgrep -u "$u" > /dev/null && die "processes of $u do not end; rerun migrate-name (done steps are skipped)"
      oldhome="$(getent passwd "$u" | cut -d: -f6)"
      newhome="${oldhome/\/$old-/\/$new-}"
      if [ -d "$oldhome" ]; then
        usermod -l "$nu" -d "$newhome" -m "$u"
      else
        usermod -l "$nu" -d "$newhome" "$u"   # a home never made (the dashboard's user)
      fi
      getent group "$u" > /dev/null && groupmod -n "$nu" "$u"
      sed -i "s/^$u:/$nu:/" /etc/subuid /etc/subgid
      [ "$nu" != "$new-web" ] && loginctl enable-linger "$nu" 2> /dev/null || true
      echo "migrate-name: $u -> $nu ($newhome)"
    done
    getent group "$old" > /dev/null && groupmod -n "$new" "$old"
    # the paths, on their own filesystems (a rename, instant)
    for d in /var/lib/$old-web /var/lib/$old /etc/$old /srv/$old; do
      [ -e "$d" ] && [ ! -e "${d/\/$old/\/$new}" ] && mv "$d" "${d/\/$old/\/$new}"
    done
    # the mv carried the mounted volumes along; fstab must follow, or the
    # next boot mounts them back on the old paths (only once the old tree is
    # gone: a /srv/$new that was there before means nothing moved)
    if [ -d /srv/$new ] && [ ! -e /srv/$old ]; then
      python3 "$here/fstab.py" rename /etc/fstab "/srv/$old" "/srv/$new" | sed 's/^/migrate-name: fstab: /'
    fi
    # links and files that name the old paths: units' links in each home,
    # podman's storage.conf, the pools, the projects' settings
    for h in /home/$new-*; do
      [ -d "$h" ] || continue
      find "$h" -maxdepth 3 -type l 2> /dev/null | while read -r l; do
        t="$(readlink "$l")"
        case "$t" in
          /srv/$old/*|/home/$old-*) ln -sfn "$(echo "$t" | sed "s#/srv/$old/#/srv/$new/#; s#/home/$old-#/home/$new-#")" "$l" ;;
        esac
      done
      f="$h/.config/containers/storage.conf"
      [ -f "$f" ] && sed -i "s#/srv/$old/#/srv/$new/#g; s#/home/$old-#/home/$new-#g" "$f"
      ak="$h/.ssh/authorized_keys"
      [ -f "$ak" ] && sed -i "s#/usr/local/bin/$old-job#/usr/local/bin/$new-job#" "$ak"
    done
    # the machine's settings name the data filesystem (projects_dir): the
    # installed box.toml, and this checkout's box.local.toml for a later
    # init --config
    for f in /var/lib/$new/pools.json /var/lib/$new/projects/*.json /var/lib/$new/volumes/*.json \
        /etc/$new/box.toml "$here/box.local.toml"; do
      [ -f "$f" ] && sed -i "s#/srv/$old/#/srv/$new/#g; s#/home/$old-#/home/$new-#g" "$f"
    done
    # SELinux: the same contexts on the new paths
    semanage fcontext -l -C 2> /dev/null | awk -v o="/srv/$old" '$1 ~ "^"o {print $1, $NF}' | while read -r spec ctx; do
      t="$(echo "$ctx" | cut -d: -f3)"
      semanage fcontext -a -t "$t" "${spec/\/srv\/$old/\/srv\/$new}" 2> /dev/null || true
      semanage fcontext -d "$spec" 2> /dev/null || true
    done
    [ -d /srv/$new ] && restorecon -R /srv/$new
    # the old system files go; init writes the new ones
    rm -f /etc/sudoers.d/$old /usr/local/bin/$old-job /etc/systemd/system/user@.service.d/$old-delegate.conf
    for unit in $renamed_units; do rm -f "/etc/systemd/system/$old-$unit"; done
    systemctl daemon-reload
    # podman's database remembers the storage paths it was created with and
    # refuses to start when storage.conf names others ("database static dir
    # ... does not match"): the same paths, renamed, in each project's db
    for db in /srv/$new/projects/*/containers/db.sql; do
      [ -f "$db" ] || continue
      p="$(basename "$(dirname "$(dirname "$db")")")"
      cp -a "$db" "$backup/$p.db.sql.$(date +%Y%m%d-%H%M%S)" 2> /dev/null || true
      python3 - "$db" "/srv/$old/" "/srv/$new/" << 'EOF'
import sqlite3, sys
db, old, new = sys.argv[1:]
c = sqlite3.connect(db)
for col in ("StaticDir", "GraphRoot", "VolumeDir"):
    c.execute(f"update DBConfig set {col} = replace({col}, ?, ?)", (old, new))
c.commit()
EOF
    done
    # the projects' user managers were stopped to rename the accounts: they
    # come back now (podman needs /run/user/<uid>), not only at the next boot
    for f in /var/lib/systemd/linger/$new-*; do
      [ -e "$f" ] || continue
      uid="$(id -u "$(basename "$f")" 2> /dev/null)" || continue
      systemctl reset-failed "user@$uid.service" 2> /dev/null || true
      systemctl start "user@$uid.service" 2> /dev/null || echo "migrate-name: user@$uid.service does not start (see journalctl -u user@$uid)"
    done
    if [ "$mode" = --reverse ]; then
      # the old code, from the backup, installs the old names again
      [ -f "$backup/sudoers.d-bench" ] || cp -a "$backup/bench" /etc/sudoers.d/bench 2> /dev/null || true
      cp -a "$backup"/bench-*.service "$backup"/bench-*.timer /etc/systemd/system/ 2> /dev/null || true
      rm -rf /usr/local/lib/bench && cp -a "$backup/lib-bench" /usr/local/lib/bench
      printf '#!/bin/sh\nexec /usr/bin/python3 /usr/local/lib/bench/bench.py entry\n' > /usr/local/bin/bench-job && chmod 755 /usr/local/bin/bench-job
      rm -rf /usr/local/lib/mcu /etc/sudoers.d/mcu /usr/local/bin/mcu-job /etc/systemd/system/user@.service.d/mcu-delegate.conf
      printf '[Service]\nDelegate=cpu cpuset io memory pids\n' > /etc/systemd/system/user@.service.d/bench-delegate.conf
      systemctl daemon-reload
      for unit in bench-dashboard.service bench-task.service bench-recover.service bench-prune.timer bench-usage.timer bench-collect.timer; do
        systemctl enable --now "$unit" > /dev/null 2>&1 || true
      done
      rm -f /var/lib/bench/maintenance.json
      mv "$backup" "$backup.reversed-$(date +%Y%m%d-%H%M%S)"
      echo "migrate-name: reversed; the queue is open again"
      exit 0
    fi
    # the new names installed from this checkout, then the aliases
    "$0" init
    rm -rf /usr/local/lib/bench   # the old code (in the backup, for --reverse)
    for u in $(getent passwd | cut -d: -f1 | grep '^mcu-' | grep -v '^mcu-web$'); do
      a="bench-${u#mcu-}"
      getent passwd "$a" > /dev/null && continue
      IFS=: read -r _ _ uid gid _ home shell < <(getent passwd "$u")
      echo "$a:x:$uid:$gid:alias of $u (until migrate-name --drop-aliases):$home:$shell" >> /etc/passwd
      echo "$a:*:$(($(date +%s) / 86400)):0:99999:7:::" >> /etc/shadow
      # the account's groups (mcu, to read the state) go by name: the alias joins them
      for g in $(getent group | awk -F: -v u="$u" '("," $4 ",") ~ ("," u ",") {print $1}'); do
        gpasswd -a "$a" "$g" > /dev/null
      done
    done
    rm -f /var/lib/mcu/maintenance.json
    "$0" queue open > /dev/null   # init turned the renaming's closure into queue.json
    echo "migrate-name: done; the queue is open. Check: mcu-admin status, and a job on each project"
    ;;
  list)
    for f in "$state"/projects/*.json; do
      [ -f "$f" ] || continue
      p="$(basename "$f" .json)"
      key=revoked; [ -s "$state/keys/$p.fingerprint" ] && key="$(cat "$state/keys/$p.fingerprint")"
      printf '%-12s %s  key %s\n' "$p" "$(tr -d '\n ' < "$f")" "$key"
    done
    ;;
  *)
    die "usage: init | config show | doctor | uninstall [--purge] | invite <project> | revoke <project> | migrate-name [--reverse | --drop-aliases] | reclaim | purge | migrate | gpu | pool | envelope | task | timing | prune | queue | maintenance | passwd | list"
    ;;
esac
