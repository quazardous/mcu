#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Fails on issue-tracker references (a hash and 3 to 5 digits) in the
tracked files, or in a commit message given as an argument: the code and the
history say why in full, they don't point to a private tracker. Quoted hex
colours are not references.

    scripts/check-refs                 the tracked files (CI, pre-commit)
    scripts/check-refs <message file>  a commit message (commit-msg hook)
"""

import re
import subprocess
import sys

REF = re.compile(r"(?<![\w&#/\"'])#\d{3,5}\b(?![0-9a-fA-F])")
SKIP = ("package-lock.json",)


def scan(name, text):
    found = 0
    for n, line in enumerate(text.splitlines(), 1):
        for m in REF.finditer(line):
            print(f"{name}:{n}: tracker reference {m.group()}: say why in full instead", file=sys.stderr)
            found += 1
    return found


if len(sys.argv) == 2:
    text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
    body = "\n".join(l for l in text.splitlines() if not l.startswith("#"))  # git's comment lines
    sys.exit(1 if scan("commit message", body) else 0)
files = subprocess.run(["git", "ls-files", "-z"], capture_output=True, text=True, check=True).stdout.split("\0")
total = 0
for f in files:
    if not f or f.endswith(SKIP):
        continue
    try:
        total += scan(f, open(f, encoding="utf-8").read())
    except (UnicodeDecodeError, FileNotFoundError, IsADirectoryError):
        pass
sys.exit(1 if total else 0)
